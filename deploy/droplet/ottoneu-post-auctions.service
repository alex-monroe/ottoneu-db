# Post Auctions on the droplet: scrape the public auctions page, then post what
# opened or closed to the league's #auctions channel. Started every five minutes
# by ottoneu-post-auctions.timer; GitHub's post-auctions.yml stays on an hourly
# fallback schedule. Overlapping runs never post twice: discord_posts is claimed
# before each send.
[Unit]
Description=Ottoneu FA auctions to Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/ottoneu-db
Environment=PYTHONUNBUFFERED=1
# The league #auctions channel, not the general one the other feed posts use.
Environment=DISCORD_CHANNEL_ID=1409590042422149211
Environment=SITE_URL=https://sofa-db.vercel.app
ExecStart=/home/deploy/ottoneu-db/deploy/droplet/post-auctions.sh
TimeoutStartSec=8min
Nice=5
MemoryMax=600M
