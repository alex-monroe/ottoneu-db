# Supabase credentials for Python scripts
# Copy this file to .env and fill in your values
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# FanGraphs credentials (for arbitration progress scraper)
FANGRAPHS_USERNAME=your-fangraphs-username
FANGRAPHS_PASSWORD=your-fangraphs-password

# E2E test account for agents (devcontainer / cloud sessions) — `just e2e-login`.
# A non-admin user with projections access. Get the values from the maintainer;
# in the devcontainer they are forwarded from your host shell (devcontainer.json).
E2E_EMAIL=
E2E_PASSWORD=
# E2E_BASE_URL=https://sofa-db.vercel.app   # default: http://localhost:3000
