# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Secret Key (server-side only, bypasses RLS)
# Get from Supabase Dashboard > Settings > API Keys
# Also accepts OTTONEU_DB_SUPABASE_SECRET_KEY (Vercel Supabase integration)
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Session Secret
# Random string used to sign session tokens (HMAC key)
SESSION_SECRET=your_random_secret_here

# MCP Server API Key
# Shared bearer key for the remote MCP endpoint (/api/mcp/mcp).
# Generate with: openssl rand -hex 32. Unset = MCP endpoint rejects all requests.
# See docs/references/mcp-server.md
MCP_API_KEY=your_mcp_api_key
